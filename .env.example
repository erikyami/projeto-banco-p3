# ===================================================================
# Arquivo de Exemplo de Configuração de Ambiente (.env)
# Sistema de Gestão de Eventos Acadêmicos - BICT/UFMA
# ===================================================================

# --- Conexão com o Banco de Dados (MariaDB / MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=eventos_user
DB_PASSWORD=eventos_pass
DB_NAME=eventos_db

# Senha de root do MariaDB (usada pelo container docker-compose)
MYSQL_ROOT_PASSWORD=root_secret

# --- Segurança & Autenticação ---
# Chave secreta utilizada para assinar os tokens JWT de sessão
JWT_SECRET=bict_ufma_banco_de_dados_2026_secret_key

# --- Aplicação Web (FastAPI) ---
PORT=8000
